{
  "name": "chat-bridge-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"*.{js,ts,json}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "typecheck:test": "vue-tsc --noEmit -p tsconfig.vitest.json"
  },
  "dependencies": {
    "@comark/vue": "^0.9.2",
    "@iconify-json/lucide": "^1.2.158",
    "@nuxt/ui": "^4.13.0",
    "@orpc/contract": "^1.16.4",
    "@tanstack/charts": "^1.5.0",
    "@tanstack/vue-query": "^5.108.2",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.21.1",
    "eventsource-parser": "^4.1.3",
    "pinia": "^4.1.0",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  }
}
